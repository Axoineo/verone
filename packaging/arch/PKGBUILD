# Maintainer: Verone contributors <https://github.com/Axoineo/verone>
#
# Builds Verone from this checkout. Run from this folder:
#
#   makepkg -f
#   sudo pacman -U verone-*.pkg.tar.zst
#
# After the first tagged release, a separate PKGBUILD that downloads the release
# archive will be published for the AUR.

pkgname=verone
pkgver=0.1.0
pkgrel=1
pkgdesc="A virtual Android phone that runs on your computer"
arch=('x86_64')
url="https://github.com/Axoineo/verone"
license=('Apache-2.0')
depends=('docker' 'gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=(
  'android-tools: needed for verone adb, verone install and verone open'
  'scrcpy: needed for verone open'
)
# Link-time optimisation is configured in Cargo.toml; no debug package is built.
options=('!lto' '!debug')

# The repository root, two folders above this file.
_repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

pkgver() {
  sed -n 's/^version = "\(.*\)"$/\1/p' "$_repo/Cargo.toml" | head -1
}

build() {
  cd "$_repo"
  cargo build --release --locked --package verone-cli --target-dir "$srcdir/target"
}

package() {
  local bin="$srcdir/target/release/verone"
  install -Dm755 "$bin" "$pkgdir/usr/bin/verone"

  "$bin" completions bash | install -Dm644 /dev/stdin \
    "$pkgdir/usr/share/bash-completion/completions/verone"
  "$bin" completions zsh | install -Dm644 /dev/stdin \
    "$pkgdir/usr/share/zsh/site-functions/_verone"
  "$bin" completions fish | install -Dm644 /dev/stdin \
    "$pkgdir/usr/share/fish/vendor_completions.d/verone.fish"

  install -Dm644 "$_repo/README.md" "$pkgdir/usr/share/doc/verone/README.md"
  install -Dm644 "$_repo/CHANGELOG.md" "$pkgdir/usr/share/doc/verone/CHANGELOG.md"
  install -Dm644 "$_repo/NOTICE" "$pkgdir/usr/share/licenses/verone/NOTICE"
}
